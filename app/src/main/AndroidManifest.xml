<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The voice mode's LiveKit library declares these; Eva never uses a camera nor captures the screen (27/10/2026). -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" tools:node="remove" />
    <!-- Une question qui attend une réponse, une réponse prête : notifiées hors de l'écran. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Les notifications poussées du serveur (19/10/2026), suivies par l'app elle-même. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Le mode vocal en arrière-plan (28/10/2026) : le micro reste ouvert pendant la conversation. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!--
        allowBackup="false" covers cloud backup on every Android version; dataExtractionRules
        (Android 12+) is what governs a device-to-device transfer, which allowBackup alone no
        longer excludes an app from. Both stay: see res/xml/data_extraction_rules.xml (M5).
    -->
    <application
        android:name=".LibreChatApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LibreChat">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LibreChat.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Le retour du portail d'authentification.

                Le code d'autorisation revient forcément par un POST de formulaire — Authelia
                l'impose dès qu'on demande le scope `authelia.bearer.authz` — et un POST ne se
                délivre pas à un schéma d'application. C'est donc une route HTTPS du planificateur
                qui le reçoit, et qui rebondit ici en GET (D-049 côté serveur).

                Ce détour remplace la socket sur 127.0.0.1 essayée le 24/08 : Android gèle une
                application passée en arrière-plan, et son `accept()` ne s'exécute plus pendant que
                la personne est dans son navigateur. Un lien profond, lui, RÉVEILLE l'application.

                Le schéma est réclamable par n'importe quelle application installée. C'est la limite
                connue du motif, couverte par PKCE et `state` : un code intercepté ne s'échange pas
                sans le `code_verifier`, qui n'a jamais quitté ce processus.

                Il n'est PAS suffixé par variante, contrairement à l'applicationId. Conséquence à
                connaître : avec le debug et la release installés côte à côte, le système propose un
                choix, et se tromper coûte une connexion — jamais un jeton, la mauvaise variante
                n'ayant pas le `code_verifier`. Le suffixer imposerait au serveur de savoir vers
                quelle variante rebondir, donc de le lire quelque part dans la requête : un
                paramètre de redirection choisi par l'appelant, ce qu'on refuse.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:scheme="at.hobbitton.chat" />
            </intent-filter>

            <!--
                Une notification poussée du serveur (ntfy, 19/10/2026) : une décision à prendre, une
                question posée. Son lien nomme la conversation à ouvrir.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="conversation"
                    android:scheme="at.hobbitton.chat" />
            </intent-filter>

            <!--
                D-077 : plus de liens `librechat://` ni de partage vers une conversation. Les écrans
                qu'ils ouvraient appartenaient à LibreChat, qui n'existe plus ; seul le retour du
                portail ci-dessus est encore reçu.
            -->
        </activity>

        <!-- Les fichiers d'une conversation, ouverts par le visualiseur du téléphone (19/10/2026). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attachment_paths" />
        </provider>

        <!-- Le flux des notifications poussées (PushService, 19/10/2026). -->
        <service
            android:name=".push.PushService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- Le mode vocal, téléphone verrouillé ou app quittée (VoiceCallService, 28/10/2026). -->
        <service
            android:name=".voice.VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".push.PushBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
